<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="number_between_a_range"/>
        <attribute name="authors" value="onrad"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-30 08:04:58 PM"/>
        <attribute name="created" value="b25yYWQ7QVJDSExJTlVYOzIwMjYtMDktMzA7MDc6NTc6MTEgUE07MjUwNQ=="/>
        <attribute name="edited" value="b25yYWQ7QVJDSExJTlVYOzIwMjYtMDktMzA7MDg6MDQ6NTggUE07MTsyNjE3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nbr" type="Integer" array="False" size=""/>
            <output expression="&quot;Entrer un nombre entre 1 et 999&quot;" newline="True"/>
            <input variable="nbr"/>
            <if expression="nbr &gt; 10">
                <then>
                    <if expression="nbr &lt; 100">
                        <then>
                            <output expression="&quot;Le nombre est une dizaine&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Le nombre est une centaine&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Le nombre est une unit&#233;&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
