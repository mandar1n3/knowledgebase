    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="color" type="String" array="False" size=""/>
            <assign variable="color" expression="&quot;vert&quot;"/>
            <if expression="color == &quot;vert&quot;">
                <then>
                    <assign variable="color" expression="&quot;orange&quot;"/>
                    <output expression="&quot;Le feux est &quot; &amp; color" newline="True"/>
                    <if expression="color == &quot;orange&quot;">
                        <then>
                            <assign variable="color" expression="&quot;rouge&quot;"/>
                            <output expression="&quot;Le feux est &quot; &amp; color" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
