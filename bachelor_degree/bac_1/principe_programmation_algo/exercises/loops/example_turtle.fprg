    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nbrDeCoter" type="Integer" array="False" size=""/>
            <output expression="&quot;Entrer le nombre de coter&quot;" newline="True"/>
            <input variable="nbrDeCoter"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="1" end="nbrDeCoter" direction="inc" step="1">
                <forward expression="100" pen="down"/>
                <turn expression="360 / nbrDeCoter" rotate="right"/>
            </for>
        </body>
    </function>
</flowgorithm>
