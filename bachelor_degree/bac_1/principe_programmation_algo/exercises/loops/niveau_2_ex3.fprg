    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="nbr" type="Integer" array="False" size=""/>
            <declare name="sum" type="Integer" array="False" size=""/>
            <assign variable="sum" expression="0"/>
            <output expression="&quot;Entrer un nombre entier positif&quot;" newline="True"/>
            <input variable="nbr"/>
            <for variable="i" start="1" end="nbr" direction="inc" step="1">
                <assign variable="sum" expression="sum + i"/>
            </for>
            <output expression="&quot;La somme est de &quot; &amp; sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
