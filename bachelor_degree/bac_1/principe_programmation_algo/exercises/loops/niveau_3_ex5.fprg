    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nbr" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Entrer un nombre entier&quot;" newline="True"/>
            <input variable="nbr"/>
            <for variable="i" start="1" end="10" direction="inc" step="1">
                <output expression="nbr &amp; &quot;*&quot; &amp; i &amp; &quot; = &quot; &amp; nbr * i" newline="True"/>
            </for>
        </body>
    </function>
