    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nbr" type="Integer" array="False" size=""/>
            <output expression="&quot;Entrer un nombre entier&quot;" newline="True"/>
            <input variable="nbr"/>
            <if expression="nbr % 2 == 0">
                <then>
                    <output expression="nbr &amp; &quot; est pair&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="nbr &amp; &quot; est impair&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
