    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nbr" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Entrer un nombre entier&quot;" newline="True"/>
            <input variable="nbr"/>
            <for variable="i" start="1" end="nbr" direction="inc" step="1">
                <if expression="nbr % i = 0">
                    <then>
                        <output expression="i" newline="True"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
